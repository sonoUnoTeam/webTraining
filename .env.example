# Environment variables for webTraining
# Copy this file to .env (development) or .env.prod (production) and fill with real values

# Django Settings
# SECRET_KEY es obligatorio si DJANGO_DEBUG no es True
SECRET_KEY=your-secret-key-here-change-in-production
# Por defecto DEBUG está apagado: poner True solo en desarrollo
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Producción (DJANGO_DEBUG=False). Ejemplo para sonotraining.um.edu.ar:
# ALLOWED_HOSTS=sonotraining.um.edu.ar
# CSRF_TRUSTED_ORIGINS=https://sonotraining.um.edu.ar
# Cookies solo por HTTPS (default True sin DEBUG)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Activar solo después de verificar que Apache envía X-Forwarded-Proto (evita loops de redirect)
# USE_X_FORWARDED_PROTO=False
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# Django sirve /media/ (audios e imágenes). Poner False cuando Apache sirva MEDIA_ROOT
# SERVE_MEDIA=True

# Base de datos
# Sin DB_ENGINE se usa SQLite (db.sqlite3): desarrollo local, tests y CI.
# Producción usa MariaDB: descomentar y completar.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=webtraining
# DB_USER=webtraining
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=3306

# Email Settings 
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
